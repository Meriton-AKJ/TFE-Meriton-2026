generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum RoomType {
  standard
  superieure
  suite
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

model Room {
  id          Int         @id @default(autoincrement())
  name        String
  type        RoomType
  capacity    Int
  family      Boolean     @default(false)
  price       Float
  featured    Boolean     @default(false)
  description String
  amenities   Json
  image       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookings    Booking[]
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id          Int           @id @default(autoincrement())
  userId      Int
  roomId      Int
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  totalPrice  Float
  status      BookingStatus @default(pending)
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id])
  room        Room          @relation(fields: [roomId], references: [id])
}
